---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import CodePlaygroundApp from '../apps/dev/CodePlayground.tsx';

const pageTitle = "Code Playground";
const pageDescription = "Write HTML, CSS, and JavaScript with a VS Code-style editor and see live preview results instantly.";
const icon = "👨‍💻";
const color = "#8b5cf6";

const suggestions = [
  { title: 'JSON Formatter', icon: '{}', href: '/json', color: '#3b82f6' },
  { title: 'CSS Formatter', icon: '💅', href: '/css-formatter', color: '#3b82f6' },
  { title: 'Regex Tester', icon: '.*', href: '/regex', color: '#10b981' }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar client:load currentPath="/code-playground" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell
      client:load
      toolTitle={pageTitle}
      toolIcon={icon}
      toolHref="/code-playground"
      toolColor={color}
      suggestions={suggestions}
    >
      

      <CodePlaygroundApp client:only="react" />
    </ToolPageShell>
  </main>
</Layout>

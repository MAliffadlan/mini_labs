---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import WordCounterApp from '../apps/text/WordCounter.tsx';

const suggestions = [
  { title: 'Case Converter', icon: 'Aa', href: '/case-converter', color: '#f59e0b' },
  { title: 'JSON Formatter', icon: '{}', href: '/json', color: '#3b82f6' },
  { title: 'Regex Tester', icon: '.*', href: '/regex', color: '#10b981' },
];
---

<Layout title="Word & Character Counter - Mini Labs">
  <Navbar client:load currentPath="/word-counter" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell client:load toolTitle="Word Counter" toolIcon="📝" toolHref="/word-counter" toolColor="#10b981" suggestions={suggestions}>
      
      <WordCounterApp client:visible />
    </ToolPageShell>
  </main>
</Layout>

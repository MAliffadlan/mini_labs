---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import CssFormatterApp from '../apps/dev/CssFormatter.tsx';

const suggestions = [
  { title: 'JSON Formatter', icon: '{}', href: '/json', color: '#3b82f6' },
  { title: 'Markdown Editor', icon: 'Ⓜ️', href: '/markdown', color: '#3b82f6' },
  { title: 'Regex Tester', icon: '.*', href: '/regex', color: '#10b981' },
];
---

<Layout title="CSS Formatter & Minifier - Mini Labs">
  <Navbar client:load currentPath="/css-formatter" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell client:load toolTitle="CSS Formatter" toolIcon="💅" toolHref="/css-formatter" toolColor="#3b82f6" suggestions={suggestions}>
      
      <CssFormatterApp client:visible />
    </ToolPageShell>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import TextDiffApp from '../apps/dev/TextDiff.tsx';

const suggestions = [
  { title: 'JSON Formatter', icon: '{}', href: '/json', color: '#3b82f6' },
  { title: 'Case Converter', icon: 'Aa', href: '/case-converter', color: '#f59e0b' },
  { title: 'Word Counter', icon: '📝', href: '/word-counter', color: '#10b981' },
];
---

<Layout title="Text Diff Checker - Mini Labs">
  <Navbar client:load currentPath="/text-diff" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell client:load toolTitle="Text Diff Checker" toolIcon="📝" toolHref="/text-diff" toolColor="#10b981" suggestions={suggestions}>
      
      <TextDiffApp client:visible />
    </ToolPageShell>
  </main>
</Layout>

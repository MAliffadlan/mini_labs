---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import CalculatorApp from '../apps/utility/Calculator.tsx';

const pageTitle = "Scientific Calculator";
const pageDescription = "A premium calculator with scientific functions: sin, cos, tan, log, sqrt, factorial, and more.";
const icon = "🧮";
const color = "#8b5cf6";

const suggestions = [
  { title: 'HEX ↔ RGB', icon: '#', href: '/hex-rgb', color: '#f59e0b' },
  { title: 'Timestamp', icon: '🕐', href: '/timestamp', color: '#8b5cf6' },
  { title: 'Base64', icon: '⇋', href: '/base64', color: '#8b5cf6' }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar client:load currentPath="/calculator" />
  <main style="max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell
      client:load
      toolTitle={pageTitle}
      toolIcon={icon}
      toolHref="/calculator"
      toolColor={color}
      suggestions={suggestions}
    >
      

      <CalculatorApp client:only="react" />
    </ToolPageShell>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import JsonCsvApp from '../apps/dev/JsonCsv.tsx';
---
<Layout title="JSON to CSV - Mini Labs">
  <Navbar client:load currentPath="/json-csv" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <div style="margin-bottom: 2.5rem;">
      <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; letter-spacing: -0.02em;">JSON → CSV Converter</h1>
      <p style="font-size: 1.0625rem; color: var(--text-secondary); max-width: 600px; line-height: 1.6;">Convert JSON arrays to downloadable CSV spreadsheets.</p>
    </div>
    <JsonCsvApp client:load />
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import UuidGeneratorApp from '../apps/dev/UuidGenerator.tsx';

const suggestions = [
  { title: 'Password Generator', icon: '🔐', href: '/password-generator', color: '#f43f5e' },
  { title: 'Hash Generator', icon: '🔒', href: '/hash', color: '#10b981' },
  { title: 'Base64 Encoder', icon: '⇋', href: '/base64', color: '#8b5cf6' },
];
---

<Layout title="Bulk UUID Generator - Mini Labs">
  <Navbar client:load currentPath="/uuid" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell client:load toolTitle="UUID Generator" toolIcon="🆔" toolHref="/uuid" toolColor="#8b5cf6" suggestions={suggestions}>
      
      <UuidGeneratorApp client:visible />
    </ToolPageShell>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import JsonFormatterApp from '../apps/json/JsonFormatter.tsx';

const suggestions = [
  { title: 'JSON → CSV', icon: '📊', href: '/json-csv', color: '#8b5cf6' },
  { title: 'Base64 Encoder', icon: '⇋', href: '/base64', color: '#8b5cf6' },
  { title: 'Regex Tester', icon: '.*', href: '/regex', color: '#10b981' },
];
---

<Layout title="JSON Formatter">
  <Navbar client:load currentPath="/json" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell client:load toolTitle="JSON Formatter" toolIcon="{}" toolHref="/json" toolColor="#3b82f6" suggestions={suggestions}>
      
      <JsonFormatterApp client:visible />
    </ToolPageShell>
  </main>
</Layout>

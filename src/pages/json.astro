---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import JsonFormatterApp from '../apps/json/JsonFormatter.tsx';

const suggestions = [
  { title: 'JSON → CSV', icon: '📊', href: '/json-csv', color: '#8b5cf6' },
  { title: 'Base64 Encoder', icon: '⇋', href: '/base64', color: '#8b5cf6' },
  { title: 'Regex Tester', icon: '.*', href: '/regex', color: '#10b981' },
];
---

<Layout title="JSON Formatter">
  <Navbar client:load currentPath="/json" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell client:load toolTitle="JSON Formatter" toolIcon="{}" toolHref="/json" toolColor="#3b82f6" suggestions={suggestions} supportShare={true}>
      <div style="margin-bottom: 2.5rem;">
        <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; letter-spacing: -0.02em;">JSON Formatter</h1>
        <p style="font-size: 1.0625rem; color: var(--text-secondary); max-width: 600px; line-height: 1.6;">Paste JSON to format, validate, and beautify</p>
      </div>
      <JsonFormatterApp client:load />
    </ToolPageShell>
  </main>
</Layout>

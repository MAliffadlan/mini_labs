---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import JwtDecoderApp from '../apps/dev/JwtDecoder.tsx';

const suggestions = [
  { title: 'Base64 Encoder', icon: '⇋', href: '/base64', color: '#8b5cf6' },
  { title: 'JSON Formatter', icon: '{}', href: '/json', color: '#3b82f6' },
  { title: 'URL Encoder', icon: '🔗', href: '/url-encoder', color: '#06b6d4' },
];
---

<Layout title="JWT Decoder - Mini Labs">
  <Navbar client:load currentPath="/jwt-decoder" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell client:load toolTitle="JWT Decoder" toolIcon="🔑" toolHref="/jwt-decoder" toolColor="#f59e0b" suggestions={suggestions}>
      
      <JwtDecoderApp client:visible />
    </ToolPageShell>
  </main>
</Layout>

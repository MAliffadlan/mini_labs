---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import NotepadApp from '../apps/text/ZenScratchpad.tsx';

const pageTitle = "Notepad";
const pageDescription = "A distraction-free, auto-saving notepad. Perfect for quick thoughts, drafts, or scripts. Never lose a keystroke again.";
const icon = "📓";
const color = "#10b981";

const suggestions = [
  { title: 'Markdown Editor', icon: 'Ⓜ️', href: '/markdown', color: '#3b82f6' },
  { title: 'Word Counter', icon: '📝', href: '/word-counter', color: '#10b981' },
  { title: 'Case Converter', icon: 'Aa', href: '/case-converter', color: '#f59e0b' }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar client:load currentPath="/scratchpad" />
  <main style="max-width: 1000px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell
      client:load
      toolTitle={pageTitle}
      toolIcon={icon}
      toolHref="/scratchpad"
      toolColor={color}
      suggestions={suggestions}
    >
      <div style="margin-bottom: 2rem; text-align: center;">
        <h1 style="font-size: 2.5rem; font-family: 'Outfit', sans-serif; font-weight: 700; color: #fff; margin-bottom: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.75rem;">
          <span style={`color: ${color}`}>{icon}</span> {pageTitle}
        </h1>
        <p style="color: var(--text-secondary); font-size: 1.125rem; max-width: 600px; margin: 0 auto;">
          {pageDescription}
        </p>
      </div>

      <NotepadApp client:only="react" />
    </ToolPageShell>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ToolPageShell from '../components/ToolPageShell.tsx';
import MarkdownEditorApp from '../apps/text/MarkdownEditor.tsx';

const suggestions = [
  { title: 'Text Diff Checker', icon: '📄', href: '/text-diff', color: '#10b981' },
  { title: 'JSON Formatter', icon: '{}', href: '/json', color: '#3b82f6' },
  { title: 'Word Counter', icon: '📝', href: '/word-counter', color: '#10b981' },
];
---

<Layout title="Markdown Live Editor - Mini Labs">
  <Navbar client:load currentPath="/markdown" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <ToolPageShell client:load toolTitle="Markdown Editor" toolIcon="Ⓜ️" toolHref="/markdown" toolColor="#3b82f6" suggestions={suggestions}>
      
      <MarkdownEditorApp client:visible />
    </ToolPageShell>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import PasswordGenerator from '../apps/security/PasswordGenerator.tsx';
---
<Layout title="Password Generator - Mini Labs">
  <Navbar client:load currentPath="/password-generator" />
  <main style="max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem;">
    <div style="margin-bottom: 2.5rem; text-align: center;">
      <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; letter-spacing: -0.02em;">Password Generator</h1>
      <p style="font-size: 1.0625rem; color: var(--text-secondary); max-width: 500px; margin: 0 auto; line-height: 1.6;">Generate cryptographically secure passwords instantly.</p>
    </div>
    <PasswordGenerator client:load />
  </main>
</Layout>

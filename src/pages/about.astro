---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import InteractiveLanyard from '../components/InteractiveLanyard.tsx';
---

<Layout title="About Mini Labs - Interactive Lanyard">
  <div style="position: relative; width: 100%; height: 100vh; overflow: hidden; background: #09090b;">
    <div style="position: absolute; top: 0; left: 0; width: 100%; z-index: 100;">
      <Navbar client:load currentPath="/about" />
    </div>
    
    <InteractiveLanyard client:only="react" />
    
    {/* Additional overlay info at the bottom */}
    <div style="position: absolute; bottom: 2rem; right: 2rem; z-index: 50; text-align: right;">
      <p style="color: rgba(255,255,255,0.4); font-family: 'Inter', sans-serif; font-size: 0.8125rem; font-weight: 500; margin: 0;">
        Built with Astro & Framer Motion
      </p>
      <p style="color: rgba(255,255,255,0.2); font-family: 'Inter', sans-serif; font-size: 0.75rem; margin: 0.25rem 0 0 0;">
        Simulated 2D spring physics
      </p>
    </div>
  </div>
</Layout>

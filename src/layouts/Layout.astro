---
// Layout.astro — Base layout with PWA, View Transitions, Settings
import { ClientRouter } from 'astro:transitions';
import SettingsModal from '../components/SettingsModal.tsx';
import CommandPalette from '../components/CommandPalette.tsx';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A collection of modern, all-in-one tools for everyone' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#8b5cf6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <title>{title} | Mini Labs</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <SettingsModal client:load />
    <CommandPalette client:load />
    <script>
      // Register Service Worker on page load
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
      // Apply saved theme immediately to prevent flash
      const theme = localStorage.getItem('mini-labs-theme') || 'dark';
      if (theme === 'system') {
        document.documentElement.setAttribute('data-theme', window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } else {
        document.documentElement.setAttribute('data-theme', theme);
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
